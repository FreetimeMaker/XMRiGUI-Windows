<Window x:Class="XMRiGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XMRiGUI"
        mc:Ignorable="d"
        Title="XMRiGUI v1.0.0" Height="650" Width="950" MinHeight="500" MinWidth="800" Background="#1E1E1E"
        Icon="/xmrigui.ico">

    <Window.Resources>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20">
                    <TextBlock Text="XMRiGUI" Foreground="#FF6600" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <ListBox x:Name="SidebarList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10" SelectionChanged="SidebarList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Padding="20,15" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#37373D"/>
                                                <Setter Property="Foreground" Value="#FF6600"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2D2E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="Profile 1" Tag="0"/>
                    <ListBoxItem Content="Profile 2" Tag="1"/>
                    <ListBoxItem Content="Profile 3" Tag="2"/>
                    <ListBoxItem Content="Settings" Tag="3" Margin="0,20,0,0"/>
                </ListBox>

                <TextBlock Grid.Row="2" Text="XMRiGUI v1.0.0" Foreground="#555555" FontSize="10" Margin="20" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Margin="30">
            <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Profile Template (will be handled by logic or repeated) -->
                <!-- For simplicity in this prompt, I'll repeat it or use a ContentControl.
                     I'll define the layout for one and bind it. -->

                <TabItem> <!-- Profile 1 -->
                    <local:ProfileView x:Name="Profile1View" DataContext="{Binding profiles[0]}"/>
                </TabItem>
                <TabItem> <!-- Profile 2 -->
                    <local:ProfileView x:Name="Profile2View" DataContext="{Binding profiles[1]}"/>
                </TabItem>
                <TabItem> <!-- Profile 3 -->
                    <local:ProfileView x:Name="Profile3View" DataContext="{Binding profiles[2]}"/>
                </TabItem>

                <TabItem> <!-- Global Settings -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="SETTINGS" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,30"/>

                            <CheckBox Content="Start with Windows" Foreground="White" Margin="0,20,0,0" IsChecked="{Binding start_with_windows}"/>
                            <CheckBox Content="Minimize to tray" Foreground="White" Margin="0,10,0,0" IsChecked="{Binding minimize_to_tray}"/>
                            <CheckBox Content="Close to tray" Foreground="White" Margin="0,10,0,0" IsChecked="{Binding close_to_tray}"/>

                            <Button Content="SAVE ALL SETTINGS" Background="#FF6600" Foreground="White" FontWeight="Bold" Height="45" Margin="0,40,0,0" Click="SaveAll_Click" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>

                            <TextBlock Text="Miner Version (Integrated): 2.26.0" Foreground="#555555" Margin="0,20,0,0" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
